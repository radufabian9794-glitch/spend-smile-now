# Postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=postgres

# Supabase JWT — generate a 32+ char random string, then derive the two keys below.
# See README.docker.md for the exact `openssl` + node one-liner.
JWT_SECRET=change-me-32-plus-character-random-string
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-with-generated-anon-jwt
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-with-generated-service-role-jwt

# Where the app is reachable from the user's browser. Used by GoTrue for email
# redirect links and OAuth callbacks.
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# SMTP (optional) — without this, signup confirmation emails won't deliver.
# For local dev, you can disable confirmations via GOTRUE_MAILER_AUTOCONFIRM=true
# in docker-compose.yml.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Lovable App
SMTP_ADMIN_EMAIL=admin@example.com

# Lovable AI Gateway — only needed if you keep using Lovable AI from the app.
# To self-host fully, swap the AI calls in app code for a direct provider.
LOVABLE_API_KEY=

# App-side env (server functions). The browser hits Supabase at localhost:8000;
# the app container hits it at http://kong:8000 inside the Docker network.
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=${ANON_KEY}
SUPABASE_URL=http://kong:8000
SUPABASE_PUBLISHABLE_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}
